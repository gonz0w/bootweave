    ],
    "source_of_values": "const observation accessor after one actual closed bw_entry_output call",
    "raw_struct_bytes_or_padding_are_not_an_oracle": true,
    "rusage_outside_this_record_projection": true,
    "driver_record_grants_no_product_output_or_retry_authority": true
  },
  "required_witness_roles": {
    "source_binding": [
      "exact clean candidate/base/tree and complete unmodified production source linkage",
      "exact driver source/build flags and native tool/profile bindings",
      "no syscall interposer, readiness override, mocked native success or live credentials",
      "driver failure paths cannot synthesize guard success or successful file-size termination"
    ],
    "native_driver": [
      "record all six actual getrlimit soft/hard pairs, not aggregate validity flags",
      "record raw REAL/PROF value and interval sec/usec observations",
      "read actual closed-entry semantic fields without modifying observation storage"
    ],
    "independent_supervisor": [
      "retain exact actual PID identity, streams, EOF, consuming wait and terminal disposition",
      "require WIFEXITED and exact exit status; timeout, WIFSIGNALED, missing wait or truncated stream fails",
      "independently verify file-size probe fd3 object identity, type, initial emptiness, final size and complete bytes/hash",
      "retain stdout/stderr separately from the owned fd3 file and reject extra bytes or success markers",
      "observe terminal absence using the separately reviewed ownership/custody envelope before forgetting process identity"
    ],
    "proof_limits": [
      "same-process child-limit readback is not a real verifier-child, launch, timer or custody qualification",
      "fixed write-call schedule is a source-bound expectation; file length/hash and termination need independent actual observations",
      "exit5 alone does not establish SIGXFSZ causality without the exact unmodified guard and driver control-flow binding",
      "host syntax/model/refusal evidence cannot satisfy any native case",
      "no native pass, locked whitelist, publication, cryptographic acceptance or production readiness follows from this catalogue"
    ]
  },
