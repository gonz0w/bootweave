  "entry_record": {
    "stream": "stderr",
    "prefix": "NQ_ENTRY",
    "record_terminator": "LF",
    "records": 1,
    "bounded_numeric_fields": [
      "result", "state", "cause", "capture", "input_close_errors", "input_unknown_closes", "final_boundary_failed",
      "auth_state", "auth_cause", "auth_material_cause", "auth_final_boundary_failed", "output_attempted", "output_bytes",
